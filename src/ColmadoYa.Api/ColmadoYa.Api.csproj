      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ColmadoYa.Application\ColmadoYa.Application.csproj" />
    <ProjectReference Include="..\ColmadoYa.Infrastructure\ColmadoYa.Infrastructure.csproj" />
  </ItemGroup>

</Project>
